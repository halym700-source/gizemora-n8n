break;\n  if (ii < images.length) media.push({type:'image', src:images[ii++]});\n}\nif (!media.length) throw new Error('Render için medya bulunamadı');\nconst seconds = 6;\nconst clips = media.map((m, i) => ({\n  asset: m.type === 'video' ? {type:'video', src:m.src, volume:0} : {type:'image', src:m.src},\n  start: i * seconds,\n  length: i === media.length - 1 ? 'end' : seconds,\n  fit: 'contain',\n  transition: {in:'fade', out:'fade'}\n}));\nreturn [{json:{\n  timeline:{\n    background:'#000000',\n    tracks:[\n      {clips:[{\n        asset:{\n          type:'rich-caption',\n          src:'alias://narration',\n          font:{family:'Roboto',size:46,color:'#FFD400',weight:700},\n          align:{vertical:'bottom'},\n          stroke:{width:3,color:'#000000',opacity:1}\n        },\n        start:0,\n        length:'end',\n        width:920,\n        height:240,\n        position:'bottom',\n        offset:{x:0,y:0.08}\n      }]},\n      {clips},\n      {clips:[{\n        alias:'narration',\n        asset:{type:'audio',prompt:d.narration,model:'elevenlabs-multilingual-v2',options:{voice:'George'}},\n        start:0,\n        length:'auto'\n      }]}\n    ]\n  },\n  output:{format:'mp4',fps:30,size:{width:1080,height:1920}}\n}}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2160,0],"id":"e0883aab-f554-45d0-b6d6-9daad2d83051","name":"Build Shotstack Edit"},{"parameters":{"method":"POST","url":"https://api.shotstack.io/edit/v1/render","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-api-key","value":"PUT_SHOTSTACK_API_KEY_HERE"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ $json }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[2400,0],"id":"cccc0677-fe73-4502-8dde-e34c05f5fdde","name":"Render Video","executeOnce":true},{"parameters":{"resume":"timeInterval","amount":75,"unit":"seconds","options":{}},"type":"n8n-nodes-base.wait","typeVersion":1.