ıcı başlık #shorts\",\n  \"youtubeDescription\": \"Türkçe 1-2 cümlelik kısa açıklama\"\n}\n\nKurallar:\n- narration ilk 2 saniyede güçlü merak uyandırsın; kısa, anlaşılır cümleler kullansın; sonunda yorum sorusu olsun.\n- searchQuery harita, diyagram, yazı, logo istemesin; olayın sahnelerini çağrıştıran insanlar, mekan, hava, nesneler gibi gerçekçi görseller ve kısa videolar bulmaya uygun olsun.\n- Sadece JSON döndür."}]},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.googleGemini","typeVersion":1.2,"position":[720,0],"id":"0c96fd10-7b78-4098-b380-799832f6a5c3","name":"Create Script & Media Plan","credentials":{"googlePalmApi":{"id":null,"name":"","__aiGatewayManaged":true}}},{"parameters":{"jsCode":"const raw = $input.first().json?.content?.parts?.[0]?.text ?? '';\nlet text = String(raw).trim().replace(/^```(?:json)?\\s*/i,'').replace(/```$/,'').trim();\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\nif (start !== -1 && end !== -1) text = text.slice(start, end + 1);\nlet plan;\ntry { plan = JSON.parse(text); } catch (e) { throw new Error('Gemini JSON parse edilemedi: ' + text); }\nconst topic = $('Select First Pending').first().json.Konu;\nreturn [{json:{\n  topic,\n  narration:String(plan.narration||'').trim(),\n  searchQuery:String(plan.searchQuery||topic).trim(),\n  youtubeTitle:String(plan.youtubeTitle||topic+' #shorts').trim(),\n  youtubeDescription:String(plan.youtubeDescription||'').trim()\n}}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[960,0],"id":"9782c343-7033-4911-b65b-862cafa8c834","name":"Parse Plan"},{"parameters":{"operation":"appendOrUpdate","documentId":{"__rl":true,"value":"1-XYN8vOjqvpKLG8y9jUbIXuR4a_pDQlP_AHPRn22P8M","mode":"list","cachedResultName":"Gizemora otomasyon","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1-XYN8vOjqvpKLG8y9jUbIXuR4a_pDQlP_AHPRn22P8M/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Sayfa1","cachedResultU